# Redis and Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Blockchain Configuration
INFURA_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
EXECUTOR_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
ARBITRAGE_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# Security Configuration
# This should be the address of your deployed SecurePriceOracle contract
SECURE_ORACLE_ADDRESS=0xYOUR_DEPLOYED_ORACLE_ADDRESS