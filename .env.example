# Flash Loan Arbitrage Bot Configuration
# Copy this file to .env and fill in your actual values

# Blockchain Configuration
RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
# SECURITY WARNING: DO NOT STORE PRIVATE KEYS IN ENVIRONMENT FILES
# Use a secure key management solution instead (see README for options)
# PRIVATE_KEY=REMOVED_FOR_SECURITY_REASONS

# Hardware Security Module (HSM) Configuration
HSM_ENABLED=true
HSM_PROVIDER=aws  # Options: aws, azure, hashicorp, fortanix, or local_signer
HSM_CONFIG_PATH=/path/to/hsm/config.json

# Multi-sig Configuration (Alternative to HSM)
MULTISIG_ENABLED=false
MULTISIG_ADDRESS=0x0000000000000000000000000000000000000000
MULTISIG_INTERFACE=gnosis  # Options: gnosis, safe

# Contract Addresses (Deploy these first)
INCUBATOR_ADDRESS=0x0000000000000000000000000000000000000000
EXECUTOR_ADDRESS=0x0000000000000000000000000000000000000000

# Gas Configuration
MAX_PRIORITY_FEE_GWEI=2.0
MAX_FEE_GWEI=100

# Bot Configuration
MIN_PROFIT_USD=50
SCAN_INTERVAL_SECONDS=15
MAX_CONCURRENT_STRATEGIES=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log

# DEX Configuration (for arbitrage opportunities)
UNISWAP_V2_ROUTER=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D
SUSHISWAP_ROUTER=0xd9e1cE17f2641f24aE83637ab66a2cca9C378B9F

# Token Addresses
WETH=0xC02aaA39b223FE8C0A0e5C4F27eAD9083C756Cc2
DAI=0x6B175474E89094C44Da98b954EedeAC495271d0F
USDC=0xA0b86a33E6441b8C0b8b2B4B3d4B3d4B3d4B3d4B

# ===========================================
# SENTINEL INTEGRATION SYSTEM CONFIGURATION
# ===========================================

# Blockchain Network Configuration for Sentinels
WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
ARBITRUM_RPC_URL=https://arbitrum-mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
OPTIMISM_RPC_URL=https://optimism-mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Sentinel Contract Addresses
ARBITRAGE_EXECUTOR_ADDRESS=0x0000000000000000000000000000000000000000
AI_STRATEGY_ADDRESS=0x0000000000000000000000000000000000000000
VAULT_ADDRESS=0x0000000000000000000000000000000000000000
ORACLE_AGGREGATOR_ADDRESS=0x0000000000000000000000000000000000000000

# Emergency Wallet Configuration for Sentinel Contract Manager
EMERGENCY_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
EMERGENCY_PRIVATE_KEY=your_emergency_private_key_here

# Oracle API Keys for Sentinel Oracle Integration
CHAINLINK_API_KEY=your_chainlink_api_key
API3_API_KEY=your_api3_api_key

# Alert Channel Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
WEBHOOK_URL=https://your-webhook-endpoint.com/alerts

# Email Configuration for Alert Routing
SMTP_SERVER=smtp.gmail.com
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
FROM_EMAIL=alerts@yourdomain.com

# SMS Configuration for Emergency Alerts
SMS_API_KEY=your_twilio_api_key
SMS_FROM_NUMBER=+1234567890

# Monitoring and Observability
GRAFANA_URL=http://localhost:3000
ELASTICSEARCH_URL=http://localhost:9200
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Sentinel Database Configuration
SENTINEL_DATABASE_URL=postgresql://user:password@localhost:5432/sentinel_db

# Security Keys for Sentinel System
SENTINEL_JWT_SECRET=your_sentinel_jwt_secret_key_here
SENTINEL_API_KEY=your_sentinel_api_key_here

# Sentinel Environment Configuration
SENTINEL_NODE_ENV=production
SENTINEL_DEBUG=false
SENTINEL_LOG_LEVEL=INFO