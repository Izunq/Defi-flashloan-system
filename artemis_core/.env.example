# Artemis AI Core Environment Configuration
# Copy this file to .env and fill in your actual values

# =================================================================
# Google AI Configuration (Primary - Recommended)
# =================================================================
GOOGLE_API_KEY=your_google_api_key_here
# Get your API key from: https://aistudio.google.com/app/apikey

# =================================================================
# OpenAI Configuration (Alternative)
# =================================================================
# OPENAI_API_KEY=your_openai_api_key_here
# Get your API key from: https://platform.openai.com/api-keys

# =================================================================
# Database Configuration
# =================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/flashloan_db
# Format: postgresql://user:password@host:port/database
# For SQLite (development): sqlite:///./artemis.db

# =================================================================
# Service Configuration
# =================================================================
ARTEMIS_PORT=8082
ARTEMIS_HOST=0.0.0.0
DEBUG=true

# =================================================================
# Security Configuration
# =================================================================
SECRET_KEY=your_secret_key_here_min_32_characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# =================================================================
# External APIs (Optional)
# =================================================================
# Blockchain RPC URLs
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
POLYGON_RPC_URL=https://polygon-rpc.com
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Infura (for blockchain data)
INFURA_PROJECT_ID=your_infura_project_id
INFURA_PROJECT_SECRET=your_infura_secret

# Alchemy (alternative to Infura)
ALCHEMY_API_KEY=your_alchemy_api_key

# =================================================================
# AI Provider Configuration
# =================================================================
AI_PROVIDER=gemini
# Options: gemini, openai, hybrid

# Gemini Model Settings (Recommended - Faster & Cheaper)
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# OpenAI Model Settings (Alternative)
# OPENAI_MODEL=gpt-4
# OPENAI_MAX_TOKENS=1000
# OPENAI_TEMPERATURE=0.7

# =================================================================
# Cache and Performance
# =================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# =================================================================
# Logging and Monitoring
# =================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/artemis.log

# =================================================================
# Development Settings
# =================================================================
ENABLE_CORS=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RELOAD_ON_CHANGE=true
