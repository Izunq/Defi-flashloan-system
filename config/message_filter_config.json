{
    "rate_limits": {
        "system:alerts:critical": 100,
        "system:alerts:high": 50,
        "system:alerts:medium": 20,
        "system:alerts:low": 10,
        "opportunities:*:discovery": 500,
        "opportunities:*:validation": 200,
        "opportunities:*:execution": 100,
        "metrics:*": 1000,
        "agent:status:*": 200,
        "*": 2000
    },
    "aggregation_rules": [
        {
            "channel_pattern": "metrics:system:*",
            "window_seconds": 10.0,
            "max_messages": 100,
            "aggregate_fields": ["value", "count"],
            "aggregate_function": "avg"
        },
        {
            "channel_pattern": "metrics:agents:*",
            "window_seconds": 5.0,
            "max_messages": 50,
            "aggregate_fields": ["value", "count"],
            "aggregate_function": "avg"
        },
        {
            "channel_pattern": "opportunities:*:discovery",
            "window_seconds": 1.0,
            "max_messages": 100,
            "aggregate_fields": ["count", "value"],
            "aggregate_function": "count"
        },
        {
            "channel_pattern": "agent:status:heartbeat",
            "window_seconds": 5.0,
            "max_messages": 1000,
            "aggregate_fields": ["count"],
            "aggregate_function": "count"
        }
    ],
    "channel_hierarchy": {
