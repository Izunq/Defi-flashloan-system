    },
    "uniswap": {
      "enabled": true,
      "weight": 0.3,
      "timeout": 30
    },
    "binance": {
      "enabled": true,
      "weight": 0.3,
      "timeout": 30
    }
  },
  "alerting": {
    "webhook_url": "",
    "email_enabled": false,
    "slack_enabled": false,
    "discord_enabled": false
  },
  "database": {
