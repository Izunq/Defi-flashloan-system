{
  "zk_proof_system_config": {
    "version": "1.0.0",
    "security_level": "maximum",
    "formal_verification": {
      "verification_timeout": 300,
      "max_proof_complexity": 1000,
      "required_security_level": 4,
      "smt_solver_path": "z3",
      "lean_prover_path": "lean",
      "verification_cache_ttl_hours": 24,
      "enable_mathematical_proofs": true,
      "enable_constraint_verification": true,
      "enable_security_analysis": true
    },
    "trusted_setup": {
      "min_participants": 5,
      "min_verifiers": 3,
      "required_entropy_sources": 10,
      "ceremony_timeout_hours": 48,
      "contribution_timeout_minutes": 60,
      "verification_timeout_minutes": 30,
      "security_level": "high",
      "required_proof_systems": ["groth16", "plonk"],
      "max_circuit_complexity": 10000,
      "network_security": {
        "require_ssl": true,
        "require_vpn": false,
        "allowed_ips": []
      },
      "deployment_environments": ["testnet", "mainnet"],
      "backup_ceremony_data": true
    },
    "proof_submission": {
      "max_submissions_per_hour": 10,
      "max_submissions_per_day": 100,
      "proof_expiry_hours": 24,
      "security_check_timeout": 30,
      "max_proof_size": 10000,
      "rate_limiting": {
        "enable_rate_limiting": true,
        "burst_allowance": 5,
        "sustained_rate": 2,
        "ban_duration_minutes": 60
      },
      "security_checks": {
        "enable_malware_scanning": true,
        "enable_content_filtering": true,
        "enable_size_validation": true,
        "enable_structure_validation": true,
        "enable_freshness_check": true,
        "enable_circuit_id_validation": true
      }
    },
    "circuit_property_testing": {
      "max_proving_time": 10.0,
      "max_memory_mb": 100,
      "timeout": 300,
      "test_vectors_per_property": 5,
      "enable_mathematical_tests": true,
      "enable_constraint_tests": true,
      "enable_security_tests": true,
      "enable_performance_tests": true,
      "enable_edge_case_tests": true,
      "test_categories": {
        "mathematical": {
          "arithmetic_integrity": true,
          "range_bounds": true,
          "mathematical_consistency": true,
          "boundary_values": true
        },
        "constraint": {
          "constraint_satisfaction": true,
          "constraint_completeness": true,
          "constraint_soundness": true
        },
        "security": {
          "zero_knowledge": true,
          "soundness": true,
          "completeness": true,
          "overflow_protection": true,
          "information_leakage": true
        },
        "performance": {
          "proving_time": true,
          "memory_usage": true,
          "constraint_count": true
        }
      }
    },
    "monitoring": {
      "enable_system_monitoring": true,
      "enable_security_monitoring": true,
      "enable_performance_monitoring": true,
      "log_level": "INFO",
      "log_retention_days": 30,
      "alert_thresholds": {
        "failed_verification_rate": 0.05,
        "high_memory_usage_mb": 500,
        "slow_proving_time_seconds": 30,
        "suspicious_submission_rate": 0.1
      },
      "notification_channels": ["email", "webhook"],
      "monitoring_intervals": {
        "health_check_seconds": 60,
        "performance_check_seconds": 300,
        "security_scan_seconds": 600
      }
    },
    "database": {
      "verification_db": "formal_verification.db",
      "ceremony_db": "trusted_setup_ceremony.db",
      "submission_db": "proof_submissions.db",
      "enable_backup": true,
      "backup_interval_hours": 6,
      "retention_days": 90
    },
    "file_paths": {
      "circuit_directory": "prover/",
      "properties_directory": "formal_verification/",
      "logs_directory": "logs/",
      "artifacts_directory": "deployed_artifacts/",
      "backup_directory": "backups/"
    },
    "circuit_requirements": {
      "max_constraints": 100000,
      "max_signals": 50000,
      "max_components": 1000,
      "required_templates": ["RangeCheck", "GreaterThan", "LessThan"],
      "forbidden_patterns": ["<script>", "eval(", "exec("],
      "security_annotations": {
        "require_input_validation": true,
        "require_overflow_protection": true,
        "require_range_checks": true
      }
    },
    "cryptographic_parameters": {
      "hash_algorithm": "sha256",
      "signature_algorithm": "rsa",
      "key_size": 2048,
      "random_source": "/dev/urandom",
      "entropy_minimum_bits": 256
    },
    "deployment": {
      "environments": {
        "development": {
          "relaxed_verification": true,
          "enable_debug_logs": true,
          "reduced_security_checks": true
        },
        "staging": {
          "full_verification": true,
          "enable_all_tests": true,
          "simulate_production": true
        },
        "production": {
          "maximum_security": true,
          "full_verification": true,
          "enable_all_monitoring": true,
          "require_ceremony_validation": true
        }
      },
      "auto_deployment": {
        "enable": false,
        "require_manual_approval": true,
        "verification_threshold": 0.95
      }
    },
    "error_handling": {
      "max_retry_attempts": 3,
      "retry_delay_seconds": 5,
      "enable_circuit_recovery": true,
      "enable_automatic_rollback": true,
      "error_notification": true
    },
    "compliance": {
      "enable_audit_logging": true,
      "enable_regulatory_compliance": true,
      "data_retention_policy": "90_days",
      "privacy_protection": true,
      "enable_gdpr_compliance": true
    }
  }
}
